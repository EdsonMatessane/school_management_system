# Copie este ficheiro para ".env" (na raiz) e preencha os valores.
# É lido pelo "docker compose" da raiz. O ".env" nunca deve ir para o Git.

# Base de dados (obrigatória)
CACOIN_DB_USER=postgres
CACOIN_DB_PASSWORD=

# Segredo para assinar as sessões. Em branco = é gerado e guardado em data/auth-secret.key.
CACOIN_AUTH_SECRET=

# Endereço(s) do frontend autorizados a chamar a API, separados por vírgulas.
CACOIN_CORS_ORIGINS=http://localhost:8081

# Palavra-passe para repartir o sistema. Em branco = valor por omissão do código: mude-a.
CACOIN_PARTITION_PASSWORD=

# Endereço da API usado pelo frontend (fixo no momento da compilação).
VITE_API_URL=http://localhost:8080/api
